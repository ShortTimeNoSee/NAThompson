<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if title %}{{ title }} | {{ site.name }}{% elif domainData %}{{ domainData.title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or (domainData.description if domainData) or site.description }}">
  <meta name="author" content="{{ site.author.legalName }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">
  {% elif domain %}<meta name="keywords" content="{{ domain | domainLabel }}, NA Thompson, structural analysis, libertarian, nathompson.com">
  {% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Favicons -->
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32">

  <!-- Open Graph -->
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ ogTitle or title or site.name }}">
  <meta property="og:description" content="{{ ogDescription or description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_US">
  {% if ogType == 'article' %}
  <meta property="og:article:published_time" content="{{ date | dateISO }}">
  {% if modified %}<meta property="og:article:modified_time" content="{{ modified | dateISO }}">{% endif %}
  <meta property="og:article:author" content="{{ site.url }}/about/">
  {% if domain %}<meta property="og:article:section" content="{{ domain | domainLabel }}">{% endif %}
  <meta property="og:article:tag" content="{{ domain | domainLabel }}">
  <meta property="og:article:tag" content="NA Thompson">
  <meta property="og:article:tag" content="structural analysis">
  {% endif %}
  {% if domain %}
  <meta property="og:image" content="{{ site.url }}/og/{{ page.fileSlug }}.png">
  {% elif domainData %}
  <meta property="og:image" content="{{ site.url }}/og/domain-{{ domainData.key }}.png">
  {% else %}
  <meta property="og:image" content="{{ site.url }}/og/default.png">
  {% endif %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.social.twitter }}">
  <meta name="twitter:creator" content="{{ site.social.twitter }}">
  <meta name="twitter:title" content="{{ ogTitle or title or site.name }}">
  <meta name="twitter:description" content="{{ ogDescription or description or site.description }}">
  {% if domain %}
  <meta name="twitter:image" content="{{ site.url }}/og/{{ page.fileSlug }}.png">
  {% elif domainData %}
  <meta name="twitter:image" content="{{ site.url }}/og/domain-{{ domainData.key }}.png">
  {% else %}
  <meta name="twitter:image" content="{{ site.url }}/og/default.png">
  {% endif %}

  <!-- Feeds -->
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}{{ site.feeds.rss }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ site.url }}{{ site.feeds.atom }}">

  <!-- JSON-LD structured data -->
  {% if structuredData %}
  <script type="application/ld+json">{{ structuredData | safe }}</script>
  {% elif not suppressBaseSchema %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "inLanguage": "en-US",
        "author": { "@id": "{{ site.url }}/#author" }
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#author",
        "name": "{{ site.author.name }}",
        "legalName": "{{ site.author.legalName }}",
        "url": "{{ site.url }}/about/",
        "jobTitle": "Political Writer",
        "description": "Nicholas A. Thompson is a Cognitive Sciences student at UC Irvine and libertarian political writer applying structural economic analysis to electoral systems, intellectual property law, cognitive capture, and urban planning. In 2026, he ran for Governor of California under the Libertarian Party.",
        "affiliation": {
          "@type": "EducationalOrganization",
          "name": "University of California, Irvine",
          "department": "Cognitive Sciences"
        },
        "memberOf": {
          "@type": "Organization",
          "name": "Libertarian Party of California"
        },
        "knowsAbout": [
          "Electoral systems and ballot access law",
          "Intellectual property as state monopoly",
          "Regulatory and cognitive capture",
          "Urban planning and car dependency",
          "Technology sovereignty and open-source",
          "Cartel theory of democratic dysfunction",
          "Libertarian political theory"
        ],
        "sameAs": [
          "https://x.com/nickispolitical",
          "https://ballotpedia.org/Nicholas_Thompson_(California)"
        ]
      }
    ]
  }
  </script>
  {% endif %}

  <!-- Theme script loads synchronously to prevent flash of wrong theme -->
  <script src="{{ "/assets/js/main.js" | asset }}"></script>

  <!-- Stylesheet -->
  <link rel="stylesheet" href="{{ "/assets/css/main.css" | asset }}">
  {% for sheet in stylesheets or [] %}
  <link rel="stylesheet" href="{{ sheet | asset }}">
  {% endfor %}

  <!-- Font preloads: only the weights actually used -->
  <link rel="preload" href="/assets/fonts/ibm-plex-serif/IBMPlexSerif-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-serif/IBMPlexSerif-Bold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-mono/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
  <a class="skip-nav" href="#main-content">Skip to content</a>

  <div id="reading-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-hidden="true">
    <svg id="reading-progress-svg" viewBox="0 0 100 1" preserveAspectRatio="none" aria-hidden="true">
      <rect id="reading-progress-fill" x="0" y="0" width="0" height="1"></rect>
    </svg>
  </div>

  <header class="site-header" role="banner">
    <div class="site-container">
      <div class="site-header-inner">
        <a class="site-header-name" href="/" aria-label="{{ site.name }} home">{{ site.name }}</a>
        <nav aria-label="Site navigation">
          <ul class="site-nav">
            {% for item in site.nav %}
            <li>
              <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            </li>
            {% endfor %}
            <li>
              <button class="theme-toggle" id="theme-toggle" aria-label="Switch color theme" type="button">Theme</button>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="site-container">
      <div class="site-footer-inner">
        <p>Licensed under <a href="{{ site.license.url }}" rel="license">{{ site.license.name }}</a></p>
        <div class="footer-feeds">
          <a href="{{ site.feeds.rss }}">RSS</a>
          <a href="{{ site.feeds.atom }}">Atom</a>
          <a href="/sitemap/">Sitemap</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
