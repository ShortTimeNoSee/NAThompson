{
  "name": "nathompson-com",
  "version": "0.1.0",
  "private": true,
  "description": "nathompson.com — diagnostic writing on state capture, monopoly, and cognitive control",
  "type": "module",
  "scripts": {
    "build": "rm -rf _site && eleventy && node scripts/generate-og-images.mjs",
    "serve": "eleventy --serve --port=8080",
    "serve:preview": "eleventy --serve",
    "watch": "eleventy --watch",
    "debug": "DEBUG=Eleventy* eleventy",
    "test": "npm run build && node tests/check-external-urls.mjs",
    "fonts": "bash scripts/download-fonts.sh"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.3",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "glob": "^11.0.0",
    "markdown-it-anchor": "^9.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
